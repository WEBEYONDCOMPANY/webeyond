{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-and-beyond",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/work", "/demos/veyil/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
